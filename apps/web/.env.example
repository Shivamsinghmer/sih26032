# apps/web — copy to .env.local and fill in.
#
# VITE_* values are inlined into the bundle AT BUILD TIME, so they must be
# present before the build runs and none of them may be a secret. Editing this
# file under a running dev server changes nothing in the browser — restart it.

# Where the API lives. No trailing slash.
VITE_API_URL="http://localhost:4000"

# The Clerk PUBLISHABLE key. The secret key never leaves apps/api.
#
# Leave this blank to run against an API that is itself in demo mode. Note the
# API decides demo mode, not the browser: this only stops the app mounting a
# Clerk provider it has no key for. If this is missing when a PRODUCTION bundle
# is built, the app ships with auth off and no error to warn you — verify a
# deploy by grepping the built assets for the pk_test_/pk_live_ prefix.
VITE_CLERK_PUBLISHABLE_KEY=""
