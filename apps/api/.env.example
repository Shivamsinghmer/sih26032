# apps/api — copy to .env and fill in. Never commit .env.
# The React app holds none of these; it has no database credentials at all,
# which is one of the better side effects of the two-service split.

# --- Neon Postgres ----------------------------------------------------------
# Two connection strings, NOT interchangeable.
#   DATABASE_URL  the pooled host — contains `-pooler`. Used by the API at runtime.
#   DIRECT_URL    the same host WITHOUT `-pooler`. Used by `prisma db push` and
#                 `migrate`, because DDL over the pooler is unreliable.
#
# Both must carry connect_timeout=15. Neon's free tier suspends the compute
# after inactivity and the first connection has to wake it — measured at 3.8s,
# 5.0s and 7.5s on this project against Prisma's 5s default. Without the longer
# timeout the first request after any idle spell fails, and every screen renders
# its error state, which looks exactly like an unseeded database.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Clerk ------------------------------------------------------------------
# Leave CLERK_SECRET_KEY blank to run in demo mode: auth is off, every panel is
# open, and the API resolves the first seeded farmer. Demo mode is decided here,
# by the API — never by the browser, which anyone can edit in devtools.
#
# Two dashboard steps before real sign-in works:
#   1. SMS -> Settings -> enable India. Every instance ships with only US and
#      Canada enabled, so Clerk refuses to send an OTP to a +91 number
#      (unsupported_country_code, HTTP 403). This is per instance AND per
#      application — a fresh app starts over at US + Canada.
#   2. Sessions -> Customize session token -> add {"metadata": "{{user.public_metadata}}"}
#      so the role rides on the JWT. Without it every request costs a Clerk
#      Backend API round trip — measured at 3912ms cold, 424-1139ms warm.
CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""

# Which seeded persona demo mode resolves: farmer | officer | admin.
# Without this demo mode could only ever be a farmer, so the officer and admin
# panels would be undevelopable with auth off. Read from the server environment
# and never from a request header — a header would let any client promote itself
# to admin. Ignored entirely once CLERK_SECRET_KEY is set.
DEMO_ROLE="farmer"

# --- Notifications ----------------------------------------------------------
# PROTOTYPE: email via Resend. PRODUCTION: SMS + IVR.
#
# Email is a deliberate substitution, not a claim that it is the right channel —
# the farmers this serves are the least likely to have an inbox, and many are on
# feature phones. Indian commercial SMS needs a DLT-registered header and
# pre-approved template bodies, which takes weeks to obtain. Email makes the
# pipeline real rather than stubbed in the meantime; the transport is one
# function to swap back.
#
# Leave the key blank and messages are rendered and recorded but not delivered.
RESEND_API_KEY=""

# Resend's shared sender works with no setup but ONLY delivers to the email
# address of the Resend account that owns the key. To send to anyone else,
# verify a domain in Resend and use an address on it.
RESEND_FROM="Mandi Queue <onboarding@resend.dev>"

# Send every notification to this one address instead of the farmer's. Required
# for a demo on the shared sender, since seeded farmers have addresses nobody
# owns. The Notification row still records the address it was meant for.
NOTIFY_REDIRECT_TO=""

# --- HTTP -------------------------------------------------------------------
# Railway injects PORT. Read it, never hardcode it.
PORT=4000
NODE_ENV=development

# Exactly the web origin, comma-separated if more than one. Never `*` — with `*`
# any page on the internet can call this API with a token it phished.
WEB_ORIGIN="http://localhost:5173"
